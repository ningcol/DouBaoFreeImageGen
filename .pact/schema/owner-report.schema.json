{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/owner-report.schema.json",
  "title": "PACT Owner Report",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "status",
    "summary",
    "before",
    "after",
    "verification",
    "consistency",
    "owner_decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "needs-owner"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "before": {
      "type": "string",
      "minLength": 1
    },
    "after": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EV-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "summary", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^EV-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "consistency": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "aligned",
            "nonblocking-drift",
            "needs-reconciliation",
            "needs-owner"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "label",
                "consequence"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "consequence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "technical_details": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
