{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/convergence-report.schema.json",
  "title": "PACT Convergence Report",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "change",
    "owner_summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "owner_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "disposition",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "aligned",
              "updated",
              "stale",
              "owner-decision",
              "not-applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "classification",
        "severity",
        "subject",
        "observed",
        "expected",
        "authority",
        "evidence",
        "recommended_action"
      ],
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "aligned",
            "stale",
            "missing",
            "partial",
            "contradicts",
            "unrequested",
            "owner-decision"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        },
        "owner_question": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "owner-decision"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": [
              "owner_question"
            ]
          }
        }
      ]
    }
  }
}
