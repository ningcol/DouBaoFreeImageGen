{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/context-envelope.schema.json",
  "title": "PACT Task Context Envelope",
  "type": "object",
  "required": [
    "version",
    "status",
    "task",
    "goal",
    "observable_success",
    "risk_level",
    "discovery_query",
    "domains",
    "artifacts",
    "applicable_rules",
    "decisions",
    "verification_targets",
    "known_unknowns",
    "risk_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "candidate",
        "sufficient"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "observable_success": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "discovery_query": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "artifact_type",
          "title",
          "score",
          "reasons"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "applicable_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "is_test",
          "symbols",
          "score",
          "reasons",
          "relation",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "is_test": {
            "type": "boolean"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "direct",
              "relative-resolved",
              "ast-resolved",
              "heuristic"
            ]
          }
        }
      }
    },
    "risk_policy": {
      "type": "object",
      "required": [
        "knowledge_limit",
        "code_context",
        "code_limit",
        "completion"
      ],
      "additionalProperties": false,
      "properties": {
        "knowledge_limit": {
          "type": "integer",
          "minimum": 1
        },
        "code_context": {
          "type": "boolean"
        },
        "code_limit": {
          "type": "integer",
          "minimum": 1
        },
        "completion": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
