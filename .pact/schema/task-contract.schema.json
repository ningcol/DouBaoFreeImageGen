{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/task-contract.schema.json",
  "title": "PACT Task Contract",
  "type": "object",
  "required": ["version", "task_id", "intent", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "kind": { "enum": ["outcome", "constraint"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
