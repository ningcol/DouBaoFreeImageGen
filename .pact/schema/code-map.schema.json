{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/code-map.schema.json",
  "title": "PACT Generated Code Map",
  "type": "object",
  "required": [
    "format_version",
    "root",
    "source_fingerprint",
    "git_head",
    "files",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 2
    },
    "root": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_head": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "language",
        "symbols",
        "imports",
        "is_test"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "python",
            "javascript",
            "typescript",
            "vue"
          ]
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "raw",
              "resolved",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "raw": {
                "type": "string",
                "minLength": 1
              },
              "resolved": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "oneOf": [
                  {
                    "enum": [
                      "ast-resolved",
                      "relative-resolved",
                      "heuristic"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "is_test": {
          "type": "boolean"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "kind",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "import"
        },
        "confidence": {
          "enum": [
            "ast-resolved",
            "relative-resolved",
            "heuristic"
          ]
        }
      }
    }
  }
}
