{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/install-manifest.schema.json",
  "title": "PACT Install Manifest",
  "type": "object",
  "required": ["format_version", "runtime_version", "files"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "runtime_version": { "type": "string", "minLength": 1 },
    "files": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["management", "installed_sha256"],
      "additionalProperties": false,
      "properties": {
        "management": { "enum": ["framework", "seed"] },
        "source_path": { "type": ["string", "null"] },
        "source_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "installed_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
