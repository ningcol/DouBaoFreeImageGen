{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/baseline.schema.json",
  "title": "PACT Baseline Review State",
  "type": "object",
  "required": ["version", "reviews"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "reviews": {
      "type": "object",
      "required": [
        "agent_bootstrap",
        "vocabulary",
        "product_truth",
        "architecture",
        "truth_ownership",
        "owner_profile",
        "verification",
        "known_drift"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_bootstrap": { "$ref": "#/$defs/reviewState" },
        "vocabulary": { "$ref": "#/$defs/reviewState" },
        "product_truth": { "$ref": "#/$defs/reviewState" },
        "architecture": { "$ref": "#/$defs/reviewState" },
        "truth_ownership": { "$ref": "#/$defs/reviewState" },
        "owner_profile": { "$ref": "#/$defs/reviewState" },
        "verification": { "$ref": "#/$defs/reviewState" },
        "known_drift": { "$ref": "#/$defs/reviewState" }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "reviewState": {
      "enum": ["pending", "reviewed", "not_applicable"]
    }
  }
}
