{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/impact-report.schema.json",
  "title": "PACT Impact Report",
  "type": "object",
  "required": [
    "version",
    "risk_level",
    "code_analysis",
    "changed_files",
    "impacted_domains",
    "deterministic_impacts",
    "candidate_impacts",
    "code_candidate_impacts",
    "unmapped_files"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "impacted_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deterministic_impacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impact"
      }
    },
    "candidate_impacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "code_candidate_impacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/codeCandidate"
      }
    },
    "unmapped_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "code_analysis": {
      "type": "boolean"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "path",
        "artifact_type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "source_file",
        "relation",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "artifact-changed",
            "declared-domain-path",
            "explicit-stable-id",
            "explicit-doc-link",
            "verification-reference"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "score",
        "reasons",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "codeCandidate": {
      "type": "object",
      "required": [
        "changed_file",
        "related_file",
        "relation",
        "score",
        "is_test",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "changed_file": {
          "type": "string",
          "minLength": 1
        },
        "related_file": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "imports",
            "imported-by"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 1
        },
        "is_test": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "relative-resolved",
            "ast-resolved",
            "heuristic"
          ]
        }
      }
    }
  }
}
