{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/explanation-packet.schema.json",
  "title": "PACT Project Explanation Packet",
  "type": "object",
  "required": [
    "version",
    "query",
    "domains",
    "product_truth",
    "architecture",
    "decisions",
    "changes",
    "drift",
    "other",
    "gaps",
    "followup"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "query": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "product_truth": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "architecture": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "drift": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "other": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "followup": {
      "type": "array",
      "items": {
        "enum": [
          "inspect-code",
          "inspect-runtime",
          "inspect-git-history",
          "inspect-tests",
          "semantic-search",
          "owner-confirmation"
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "artifact_type",
        "title",
        "score",
        "reasons",
        "excerpt"
      ],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "artifact_type": { "type": "string", "minLength": 1 },
        "status": { "type": ["string", "null"] },
        "title": { "type": "string", "minLength": 1 },
        "score": { "type": "integer", "minimum": 0 },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "excerpt": { "type": "string" }
      }
    }
  }
}
